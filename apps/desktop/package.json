{
  "name": "@phaseatlas/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup",
    "check": "tsc --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "package": "node ../../scripts/package-desktop.mjs",
    "dev": "wait-on tcp:127.0.0.1:4177 && cross-env PHASEATLAS_UI_DEV_URL=http://127.0.0.1:4177 electron dist/main.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.100",
    "@openai/codex-sdk": "0.147.0",
    "@phaseatlas/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsx": "^4.20.5",
    "@types/node": "^24.3.0",
    "cross-env": "^10.0.0",
    "electron": "43.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "wait-on": "^8.0.4"
  }
}
