  "version": "1.0.0",
  "publisher": "ketvietlab",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Themes"
  ],
  "contributes": {
    "themes": [
      {
        "id": "phaseatlas-light",
        "label": "PhaseAtlas Light",
        "uiTheme": "vs",
