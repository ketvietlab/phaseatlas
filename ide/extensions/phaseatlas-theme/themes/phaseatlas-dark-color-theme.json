  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#8F9398", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"], "settings": { "foreground": "#AFC0FF", "fontStyle": "bold" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#92C8A7" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#E7B37A" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"], "settings": { "foreground": "#83B9CF" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#D3A8E5" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#E8E6E6" } },
    { "scope": ["variable.parameter", "meta.function.parameters"], "settings": { "foreground": "#E1B98D" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#9FB0E4" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "#B6BBC4" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag"], "settings": { "foreground": "#DB8C86" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#B8A3DD" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#DDE2F7", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#F7F5F5", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#CCCCCD", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#92C8A7" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#B9C5F0", "fontStyle": "underline" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#E08079", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#83B9CF",
    "type": "#83B9CF",
    "class": { "foreground": "#83B9CF", "fontStyle": "bold" },
    "enum": "#83B9CF",
    "interface": "#83B9CF",
    "struct": "#83B9CF",
    "typeParameter": "#9AC9DA",
    "parameter": "#E1B98D",
    "variable": "#E8E6E6",
    "property": "#9FB0E4",
    "enumMember": "#E7B37A",
    "function": "#D3A8E5",
    "method": "#D3A8E5",
    "macro": "#DB8C86",
    "keyword": { "foreground": "#AFC0FF", "fontStyle": "bold" },
    "modifier": "#AFC0FF",
    "comment": { "foreground": "#8F9398", "fontStyle": "italic" },
    "string": "#92C8A7",
    "number": "#E7B37A",
    "regexp": "#DB8C86",
    "operator": "#B6BBC4",
    "decorator": "#DB8C86",
    "*.declaration": { "fontStyle": "bold" },
    "*.readonly": { "fontStyle": "italic" }
  }
}
