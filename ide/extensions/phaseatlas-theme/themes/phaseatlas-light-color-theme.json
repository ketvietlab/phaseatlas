  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6C7075", "fontStyle": "italic" } },
    { "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.operator.new"], "settings": { "foreground": "#45579F", "fontStyle": "bold" } },
    { "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"], "settings": { "foreground": "#327052" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "constant.other"], "settings": { "foreground": "#A45D18" } },
    { "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "support.type", "support.class"], "settings": { "foreground": "#2E718C" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call", "variable.function"], "settings": { "foreground": "#7C4F91" } },
    { "scope": ["variable", "variable.other.readwrite", "meta.definition.variable.name"], "settings": { "foreground": "#24262A" } },
    { "scope": ["variable.parameter", "meta.function.parameters"], "settings": { "foreground": "#8A5523" } },
    { "scope": ["variable.other.property", "support.variable.property", "meta.object-literal.key"], "settings": { "foreground": "#5167C4" } },
    { "scope": ["keyword.operator", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"], "settings": { "foreground": "#5A5C5E" } },
    { "scope": ["entity.name.tag", "punctuation.definition.tag", "meta.tag"], "settings": { "foreground": "#A64B46" } },
    { "scope": ["entity.other.attribute-name"], "settings": { "foreground": "#6B5790" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#394879", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "foreground": "#24262A", "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "foreground": "#5A5C5E", "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code.block"], "settings": { "foreground": "#327052" } },
    { "scope": ["markup.underline.link", "string.other.link"], "settings": { "foreground": "#45579F", "fontStyle": "underline" } },
    { "scope": ["invalid", "invalid.illegal"], "settings": { "foreground": "#B84D47", "fontStyle": "underline" } }
  ],
  "semanticTokenColors": {
    "namespace": "#2E718C",
    "type": "#2E718C",
    "class": { "foreground": "#2E718C", "fontStyle": "bold" },
    "enum": "#2E718C",
    "interface": "#2E718C",
    "struct": "#2E718C",
    "typeParameter": "#4389A3",
    "parameter": "#8A5523",
    "variable": "#24262A",
    "property": "#5167C4",
    "enumMember": "#A45D18",
    "function": "#7C4F91",
    "method": "#7C4F91",
    "macro": "#A64B46",
    "keyword": { "foreground": "#45579F", "fontStyle": "bold" },
    "modifier": "#45579F",
    "comment": { "foreground": "#6C7075", "fontStyle": "italic" },
    "string": "#327052",
    "number": "#A45D18",
    "regexp": "#A64B46",
    "operator": "#5A5C5E",
    "decorator": "#A64B46",
    "*.declaration": { "fontStyle": "bold" },
    "*.readonly": { "fontStyle": "italic" }
  }
}
